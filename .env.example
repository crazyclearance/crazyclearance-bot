# live = send replies | shadow = decide + log only (start here) | off = ignore all
BOT_MODE=shadow

# --- Meta (developers.facebook.com > your app) ---
META_APP_ID=
META_APP_SECRET=
# Any random string. Paste the same string into the Meta webhook settings.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# One line of JSON. Key = Facebook Page ID or Instagram account ID.
# Instagram accounts use the token of the Facebook Page they are linked to.
ACCOUNTS_JSON={"PAGE_ID_TIPTON":{"platform":"facebook","branch":"Tipton","token":"EAA..."},"IG_ID_TIPTON":{"platform":"instagram","branch":"Tipton","token":"EAA..."}}

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Answers sheet ---
# The ID from the Google Sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
# Sheet must be shared as "Anyone with the link: Viewer". Leave blank to use data/common-questions.csv
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Common Questions
SHEET_CACHE_SECONDS=300

# --- Handover to staff ---
HOLDING_DM=Thanks for your message! Someone from the team will get back to you shortly.
HUMAN_PAUSE_HOURS=12
# Optional: Slack / Discord / Google Chat incoming webhook for "needs staff" alerts
HANDOFF_WEBHOOK_URL=

# Password for the /admin review page
ADMIN_PASSWORD=
